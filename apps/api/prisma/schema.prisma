// Prisma schema for My Life Finance API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  name          String
  avatarUrl     String?

  // Preferences
  timezone String @default("Europe/Lisbon")
  locale   String @default("pt-PT")
  currency String @default("EUR")

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  memberships       WorkspaceMember[]
  sentInvites       WorkspaceInvite[] @relation("InviteSender")
  refreshTokens     RefreshToken[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  token      String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ============================================================
// WORKSPACES (AGREGADOS)
// ============================================================

enum WorkspaceType {
  PERSONAL
  HOUSEHOLD
  BUSINESS
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  type        WorkspaceType @default(PERSONAL)
  description String?
  avatarUrl   String?
  currency    String        @default("EUR")
  settings    Json          @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    WorkspaceMember[]
  invites    WorkspaceInvite[]
  accounts   Account[]
  categories Category[]

  @@index([slug])
  @@map("workspaces")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole

  notifyDueSoon     Boolean @default(true)
  notifyOverdue     Boolean @default(true)
  notifyBudgetAlert Boolean @default(true)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model WorkspaceInvite {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        MemberRole
  token       String       @unique
  status      InviteStatus @default(PENDING)
  invitedById String
  invitedBy   User         @relation("InviteSender", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  respondedAt DateTime?

  @@unique([workspaceId, email, status])
  @@index([token])
  @@index([email])
  @@map("workspace_invites")
}

// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  color       String    @default("#6B7280")
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  accounts Account[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("categories")
}

// ============================================================
// ACCOUNTS (FIXED & BUDGET)
// ============================================================

enum AccountType {
  FIXED
  BUDGET
}

enum RecurrenceType {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

model Account {
  id          String      @id @default(cuid())
  workspaceId String
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?
  type        AccountType
  icon        String?
  color       String?

  // FIXED
  isAmountFixed Boolean        @default(true)
  fixedAmount   Decimal?       @db.Decimal(12, 2)
  dueDay        Int?
  recurrence    RecurrenceType @default(MONTHLY)

  // BUDGET
  budgetAmount Decimal? @db.Decimal(12, 2)

  // Alertas
  alertDaysBefore    Int @default(3)
  alertBudgetPercent Int @default(80)

  // Estado
  isActive  Boolean   @default(true)
  startDate DateTime  @default(now())
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  instances AccountInstance[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([type])
  @@map("accounts")
}

// ============================================================
// ACCOUNT INSTANCES (Instancias Mensais)
// ============================================================

enum FixedAccountStatus {
  OPEN
  PAID
  EXEMPT
}

model AccountInstance {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  year      Int
  month     Int

  // FIXED
  amount     Decimal?           @db.Decimal(12, 2)
  dueDate    DateTime?
  status     FixedAccountStatus @default(OPEN)
  paidAt     DateTime?
  paidAmount Decimal?           @db.Decimal(12, 2)

  // BUDGET
  budgetAmount Decimal? @db.Decimal(12, 2)

  notes    String?
  clientId String?
  syncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@unique([accountId, year, month])
  @@index([accountId])
  @@index([year, month])
  @@index([status])
  @@map("account_instances")
}

// ============================================================
// TRANSACTIONS
// ============================================================

model Transaction {
  id                String          @id @default(cuid())
  accountInstanceId String
  accountInstance   AccountInstance @relation(fields: [accountInstanceId], references: [id], onDelete: Cascade)
  amount            Decimal         @db.Decimal(12, 2)
  description       String?
  date              DateTime
  location          String?
  attachmentUrl     String?
  clientId          String?
  syncedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountInstanceId])
  @@index([date])
  @@index([clientId])
  @@map("transactions")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  DUE_SOON
  OVERDUE
  BUDGET_WARNING
  BUDGET_EXCEEDED
  INVITE_RECEIVED
  MEMBER_JOINED
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  data       Json?
  read       Boolean          @default(false)
  readAt     DateTime?
  pushSent   Boolean          @default(false)
  pushSentAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// SYNC
// ============================================================

model SyncToken {
  id         String   @id @default(cuid())
  userId     String
  deviceId   String
  lastSyncAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("sync_tokens")
}

model SyncQueue {
  id          String    @id @default(cuid())
  clientId    String
  deviceId    String
  entityType  String
  entityId    String?
  operation   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([deviceId])
  @@index([processedAt])
  @@map("sync_queue")
}
