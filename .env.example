# Database
DATABASE_URL="postgresql://myfinance:myfinance_dev@localhost:5432/myfinance?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Resend (Email)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="My Life Finance <noreply@yourdomain.com>"

# VAPID (Push Notifications)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:notifications@yourdomain.com"

# Frontend
VITE_API_URL="http://localhost:3000"
VITE_VAPID_PUBLIC_KEY=""

# App
NODE_ENV="development"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
