{
  "name": "my-life-finance",
  "version": "0.1.0",
  "private": true,
  "description": "PWA for monthly expense management",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "release": "standard-version --preset conventionalcommits",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @my-life-finance/api prisma generate",
    "db:migrate": "pnpm --filter @my-life-finance/api prisma migrate dev",
    "db:push": "pnpm --filter @my-life-finance/api prisma db push",
    "db:studio": "pnpm --filter @my-life-finance/api prisma studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^7.0.5",
    "husky": "^9.1.7",
    "playwright": "^1.57.0",
    "prettier": "^3.2.4",
    "prisma": "^5.22.0",
    "standard-version": "^9.5.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "nodemailer": "^7.0.12"
  }
}
